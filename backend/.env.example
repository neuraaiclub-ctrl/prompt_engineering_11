# For PostgreSQL:
# DATABASE_URL=postgresql+psycopg://neura_user:neura_pass@localhost:5432/neura_db

# Security & JWT Token Config
SECRET_KEY=neura_hackathon_super_secret_jwt_key_2026_x894
MAX_REQUEST_SIZE_BYTES=2097152
CORS_ORIGINS=http://127.0.0.1:5500,http://localhost:5500,http://127.0.0.1:8000,http://localhost:8000

# Redis Cache & Lock Config (Optional for distributed locking)
REDIS_URL=redis://localhost:6379/0

# Seed Administrator Credentials
